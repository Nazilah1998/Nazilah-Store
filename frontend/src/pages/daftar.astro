---
import Layout from '../layouts/Layout.astro';
import RegisterForm from '../components/react/RegisterForm';
---

<Layout title="Daftar Akun Baru & Kemitraan Reseller — NAZILAH STORE">
  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="flex items-center gap-2 text-xs text-[#94a3b8] mb-8">
      <a href="/" class="hover:text-white transition">Katalog</a>
      <span>/</span>
      <span class="text-[#4edea3]">Daftar Akun Kemitraan</span>
    </div>

    <RegisterForm client:load />
  </div>
</Layout>

