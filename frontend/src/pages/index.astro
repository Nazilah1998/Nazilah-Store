---
import Layout from '../layouts/Layout.astro';
import FlashSaleSection from '../components/react/FlashSaleSection';
import GameCatalog from '../components/react/GameCatalog';

let games = [];
let flashSales = [];

try {
  const gamesRes = await fetch('http://127.0.0.1:8080/api/v1/games');
  const gamesJson = await gamesRes.json();
  if (gamesJson.success && gamesJson.data) {
    games = gamesJson.data;
  }

  const flashRes = await fetch('http://127.0.0.1:8080/api/v1/flash-sale');
  const flashJson = await flashRes.json();
  if (flashJson.success && flashJson.data) {
    flashSales = flashJson.data;
  }
